		(property "Spec" "X7R, >=10V; effective >=5uF at 5V DC bias"
			(at 0 0 0)
			(layer "F.SilkS")
			(hide yes)
			(uuid "77531d54-208a-4c9a-b52d-f97676720d39")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
		(property "Notes" "AVDD bulk for U1 (AD3552R pin 19). Basis: TPS7A4901 needs >=2.2uF effective, TI recommends 10uF; AD3552R AVDD current is constant (22mA typ, 28.5mA max) so the job is HF noise (AC PSRR 80dB @1kHz, 43dB @1MHz). Place within a few mm of pin 19 with a direct ground via. A 10uF X7R can lose 30-50% at 5V bias; 0805 footprint chosen for margin: confirm effective C from the vendor bias curve. Verify AVDD ripple at the pin during bring-up; add 1uF or a ferrite if 500kHz switching noise is seen."
			(at 0 0 0)
			(layer "F.SilkS")
			(hide yes)
			(uuid "8d99847f-e83d-4b26-8995-704fc70c2f76")
			(effects
